    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "../../../src/**/*.js",
    "../../../scripts/**/*.js",
    "../../../test/**/*.js"
  ]
}

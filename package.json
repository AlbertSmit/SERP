{
  "name": "sqlite-context",
  "version": "1.2.1",
  "description": "Local memory retrieval for LLM agents: SQLite FTS5, BM25, token-budget packing and an MCP server. No embeddings.",
  "main": "src/engine/engine.js",
  "bin": {
    "sqlite-context": "src/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test",
    "start": "node src/mcp/server.js",
    "stats": "node src/cli.js stats",
    "doctor": "node src/cli.js doctor",
    "demo:codebase": "node scripts/index-codebase.js",
    "stress": "node scripts/stress-test.js"
  },
  "keywords": [
    "sqlite",
    "fts5",
    "mcp",
    "retrieval",
    "context-packing"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  },
  "engines": {
    "node": ">=24"
  }
}
